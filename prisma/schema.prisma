generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  name      String?
  farms     Farm[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Farm {
  id                String     @id @default(cuid())
  userId            String?
  user              User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  locationName      String
  latitude          Float?
  longitude         Float?
  area              Float
  areaUnit          String     @default("acres")
  soilType          String
  waterAvailability String
  irrigationType    String     @default("Rainfed")
  season            String
  preferences       String?    // JSON string for low-risk, high-profit, etc.
  analyses          Analysis[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
}

model Crop {
  id                        String        @id @default(cuid())
  name                      String        @unique
  scientificName            String?
  season                    String        // Kharif, Rabi, Summer, Year-round
  suitableSoils             String        // JSON array string e.g. ["Loamy", "Clay"]
  waterRequirement          String        // Very Low, Low, Moderate, High, Very High
  irrigationSuitability     String?       // Drip, Sprinkler, Flood, Rainfed
  minTemperature            Float
  maxTemperature            Float
  idealTemperatureMin       Float
  idealTemperatureMax       Float
  rainfallMin               Float
  rainfallMax               Float
  averageYieldPerHectare    Float         // in kg
  yieldUnit                 String        @default("kg")
  cultivationCostPerHectare Float         // in INR
  referenceMarketPrice      Float         // in INR per kg
  marketUnit                String        @default("kg")
  durationDays              Int
  baseRisk                  Float         // 0 to 100
  marketVolatility          Float         // 0 to 100
  diseaseRisk               Float         // 0 to 100
  waterSensitivity          Float         // 0 to 100
  weatherSensitivity        Float         // 0 to 100
  description               String?
  advantages                String?       // JSON array string
  limitations               String?       // JSON array string
  isReferenceData           Boolean       @default(true)
  marketPrices              MarketPrice[]
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt
}

model MarketPrice {
  id              String   @id @default(cuid())
  cropId          String
  crop            Crop     @relation(fields: [cropId], references: [id], onDelete: Cascade)
  location        String
  price           Float
  unit            String   @default("kg")
  currency        String   @default("INR")
  date            DateTime @default(now())
  source          String   @default("Reference Dataset")
  sourceType      String   @default("reference")
  isReferenceData Boolean  @default(true)
  createdAt       DateTime @default(now())
}

model Analysis {
  id                  String   @id @default(cuid())
  farmId              String?
  farm                Farm?    @relation(fields: [farmId], references: [id], onDelete: SetNull)
  recommendedCropId  String?
  recommendedCropName String?
  finalScore          Float
  confidenceScore     Float
  estimatedRevenue    Float
  estimatedCost       Float
  estimatedProfit     Float
  scoringBreakdown    String?  // JSON string e.g. { soil: 95, profit: 91, ... }
  riskBreakdown       String?  // JSON string
  reasons             String?  // JSON array string
  explanation         String?
  createdAt           DateTime @default(now())
}
